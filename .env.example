# CD50 Aider Environment Variables (TEMPLATE)
# ──────────────────────────────────────────────────────────
# 1. Copy this file to .env:  cp .env.example .env
# 2. Replace YOUR_ZAI_API_KEY below with your real key
# 3. .env is gitignored and .aiderignored — never commit it
#
# Get your API key from: https://z.ai (API Keys section)

# OpenAI-compatible provider key for Z.ai
OPENAI_API_KEY=YOUR_ZAI_API_KEY

# Z.ai coding plan endpoint
OPENAI_API_BASE=https://api.z.ai/api/coding/paas/v4

# Default model (override per-session with: aider --model openai/glm-5.2)
AIDER_MODEL=zai/glm-4.7

# Disable analytics phone-home for privacy
AIDER_ANALYTICS=false
